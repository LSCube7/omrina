<Page
    x:Class="Omrina.Desktop.ExamAnswerKeyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Text="答案与评分" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="ExamNameText" Text="请先选择考试并保存答题卡。" TextWrapping="Wrap" />
            <TextBlock Text="为整场考试设置选择题答案。分值来自题目设置，学生答卷共用这套评分规则。主观题在批阅时逐题评分。" TextWrapping="Wrap" />
            <ListView x:Name="AnswersList" SelectionMode="None" MaxHeight="560">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="8" Padding="8">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <ComboBox Header="标准答案" ItemsSource="{Binding Options}" SelectedItem="{Binding Answer, Mode=TwoWay}" MinWidth="120" HorizontalAlignment="Left" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button x:Name="SaveButton" Content="保存标准答案" Click="Save_Click" IsEnabled="False" HorizontalAlignment="Left" />
            <Button Content="撤销未保存修改" Click="Discard_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
