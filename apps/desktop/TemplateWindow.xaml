<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Omrina.Desktop.TemplatePage" NavigationCacheMode="Required">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="24" Spacing="12">
            <TextBlock Text="编排答题卡" Style="{StaticResource TitleTextBlockStyle}"/>
            <Grid x:Name="EditorGrid" ColumnSpacing="16" RowSpacing="16" SizeChanged="EditorGrid_SizeChanged" ColumnDefinitions="340,*" RowDefinitions="Auto,Auto">
                <StackPanel x:Name="EditorPanel" Spacing="10">
                    <Expander Header="考试与纸张" IsExpanded="True" HorizontalAlignment="Stretch">
                        <ContentControl x:Name="SettingsPanel" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <TextBox x:Name="ExamIdBox" Header="考试编号" Text="" TextChanged="InputChanged"/>
                                <TextBox x:Name="TitleBox" Header="考试标题" Text="答题纸" TextChanged="InputChanged"/>
                                <NumberBox x:Name="VersionBox" Header="版式版本" Value="1" Minimum="1" Maximum="1000000" SmallChange="1" SpinButtonPlacementMode="Inline" ValueChanged="NumberChanged"/>
                                <ComboBox x:Name="PaperBox" Header="纸张" SelectedIndex="0" SelectionChanged="SelectionChanged">
                                    <ComboBoxItem Content="A4 纵向"/>
                                    <ComboBoxItem Content="A3 横向"/>
                                </ComboBox>
                                <ComboBox x:Name="ColumnsBox" Header="A3 分栏" SelectedIndex="0" SelectionChanged="SelectionChanged">
                                    <ComboBoxItem Content="两栏"/>
                                    <ComboBoxItem Content="三栏"/>
                                </ComboBox>
                                <ComboBox x:Name="ModeBox" Header="内容模式" SelectedIndex="0" SelectionChanged="SelectionChanged">
                                    <ComboBoxItem Content="独立答题卡"/>
                                    <ComboBoxItem Content="包含题目正文"/>
                                </ComboBox>
                                <CheckBox x:Name="DuplexBox" Content="双面打印" Checked="CheckChanged" Unchecked="CheckChanged"/>
                                <CheckBox x:Name="RepeatIdentityBox" Content="反面重复考生身份区" IsChecked="True" Checked="CheckChanged" Unchecked="CheckChanged"/>
                                <ComboBox x:Name="IdentityBox" Header="考号填写" SelectedIndex="0" SelectionChanged="SelectionChanged">
                                    <ComboBoxItem Content="条码"/>
                                    <ComboBoxItem Content="涂卡"/>
                                </ComboBox>
                                <NumberBox x:Name="DigitsBox" Header="考号位数" Value="8" Minimum="1" Maximum="20" SmallChange="1" SpinButtonPlacementMode="Inline" ValueChanged="NumberChanged"/>
                                <TextBox x:Name="CandidateIdBox" Header="预印考号（条码可选）" Text="" TextChanged="InputChanged"/>
                                <ComboBox x:Name="ShapeBox" Header="填涂框" SelectedIndex="0" SelectionChanged="SelectionChanged">
                                    <ComboBoxItem Content="圆形"/>
                                    <ComboBoxItem Content="矩形"/>
                                </ComboBox>
                                <ComboBox x:Name="LabelBox" Header="字母和数字位置" SelectedIndex="0" SelectionChanged="SelectionChanged">
                                    <ComboBoxItem Content="框外"/>
                                    <ComboBoxItem Content="框内"/>
                                </ComboBox>
                                <NumberBox x:Name="BubbleWidthBox" Header="圆框直径 / 矩形宽（毫米）" Value="1.8" Minimum="0.1" Maximum="2" SmallChange="0.1" SpinButtonPlacementMode="Inline" ValueChanged="NumberChanged"/>
                                <NumberBox x:Name="BubbleHeightBox" Header="矩形高（毫米）" Value="1.8" Minimum="0.1" Maximum="2" SmallChange="0.1" SpinButtonPlacementMode="Inline" ValueChanged="NumberChanged"/>
                            </StackPanel>
                        </ContentControl>
                    </Expander>
                    <TextBlock Text="题目" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AddQuestionButton" Content="添加题目" Click="AddQuestion_Click"/>
                        <Button x:Name="RemoveQuestionButton" Content="删除所选题目" Click="RemoveQuestion_Click"/>
                    </StackPanel>
                    <ListView x:Name="QuestionList" MaxHeight="180" SelectionChanged="QuestionList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="题组" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <ComboBox x:Name="LayoutOrderBox" Header="题组排列" SelectedIndex="0" SelectionChanged="SelectionChanged">
                        <ComboBoxItem Content="按组混排"/>
                        <ComboBoxItem Content="先选择题组，再解答题组"/>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AddGroupButton" Content="新建空组" Click="AddGroup_Click"/>
                        <Button x:Name="RemoveGroupButton" Content="删除空组" Click="RemoveGroup_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="MoveGroupUpButton" Content="题组上移" Click="MoveGroupUp_Click"/>
                        <Button x:Name="MoveGroupDownButton" Content="题组下移" Click="MoveGroupDown_Click"/>
                    </StackPanel>
                    <ListView x:Name="GroupList" MaxHeight="140" SelectionChanged="GroupList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Spacing="8">
                        <TextBox x:Name="GroupTitleBox" Header="题组名称" MaxLength="60" TextChanged="GroupTitleChanged" HorizontalAlignment="Stretch"/>
                        <Button x:Name="ApplyGroupTitleButton" Content="应用组名" Click="ApplyGroupTitle_Click"/>
                    </StackPanel>
                    <TextBlock Text="题组用于安排排版与题目顺序；组级裁切与阅卷映射将在后续版本实现。" TextWrapping="Wrap"/>
                    <ContentControl x:Name="QuestionPanel" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <NumberBox x:Name="QuestionNumberBox" Header="题号" Value="1" Minimum="1" Maximum="1000000" SmallChange="1" SpinButtonPlacementMode="Inline" ValueChanged="NumberChanged"/>
                            <ComboBox x:Name="QuestionTypeBox" Header="题型" SelectedIndex="0" SelectionChanged="QuestionType_SelectionChanged">
                                <ComboBoxItem Content="选择题"/>
                                <ComboBoxItem Content="解答题"/>
                            </ComboBox>
                            <ComboBox x:Name="QuestionGroupBox" Header="所属题组" SelectionChanged="QuestionGroup_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <NumberBox x:Name="ScoreBox" Header="满分" Value="1" Minimum="0.01" Maximum="1000000" SmallChange="0.5" SpinButtonPlacementMode="Inline" ValueChanged="NumberChanged"/>
                            <TextBox x:Name="BodyBox" Header="题目正文" Text="" TextChanged="InputChanged" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"/>
                            <NumberBox x:Name="OptionCountBox" Header="选项数" Value="4" Minimum="2" Maximum="6" SmallChange="1" SpinButtonPlacementMode="Inline" ValueChanged="NumberChanged"/>
                            <TextBox x:Name="OptionsBox" Header="选项正文（每行一个，按 A–F 顺序）" Text="" TextChanged="InputChanged" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"/>
                            <NumberBox x:Name="HeightBox" Header="本题答题区高（毫米）" Value="30" Minimum="10" Maximum="230" SmallChange="1" SpinButtonPlacementMode="Inline" ValueChanged="NumberChanged"/>
                            <TextBlock Text="解答区宽度自动占满所在栏。图片正文暂未提供，请使用文字；不会自动导入图片。" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="MoveQuestionUpButton" Content="本组内上移" Click="MoveQuestionUp_Click"/>
                                <Button x:Name="MoveQuestionDownButton" Content="本组内下移" Click="MoveQuestionDown_Click"/>
                            </StackPanel>
                            <Button x:Name="ApplyQuestionButton" Content="应用所选题目" Click="ApplyQuestion_Click"/>
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
                <StackPanel x:Name="PreviewPanel" Grid.Column="1" Spacing="10">
                    <StackPanel Spacing="8">
                        <Button x:Name="GenerateButton" Content="生成并保存版式" Click="GenerateButton_Click"/>
                        <Button x:Name="SaveSvgButton" Content="保存当前页 SVG" Click="SaveSvgButton_Click"/>
                        <Button x:Name="PrintButton" Content="打印整份答题卡" Click="PrintButton_Click"/>
                        <Button x:Name="ImportButton" Content="采集当前页" Click="ImportButton_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TemplateStatusText" TextWrapping="Wrap"/>
                    <ComboBox x:Name="PagePicker" Header="预览页" SelectionChanged="PagePicker_SelectionChanged"/>
                    <Border Background="White" BorderBrush="Gray" BorderThickness="1">
                        <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
                            <Canvas x:Name="PreviewCanvas" Background="White"/>
                        </Viewbox>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
