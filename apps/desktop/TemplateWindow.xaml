<Window
    x:Class="AnswerSheet.Desktop.TemplateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    Title="答题纸模板 - M1">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="答题纸模板" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Text="设置题数和选项，预览并保存可打印的 A4 答题纸。" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBox x:Name="TitleBox" Header="标题" Text="答题纸" PlaceholderText="最多 24 个字符，不能换行" TextChanged="TitleBox_TextChanged" automation:AutomationProperties.Name="标题" />
                <NumberBox x:Name="QuestionCountBox" Header="题数" Value="20" Minimum="1" SpinButtonPlacementMode="Inline" ValueChanged="NumberBox_ValueChanged" automation:AutomationProperties.Name="题数" />
                <NumberBox x:Name="OptionsPerQuestionBox" Header="每题选项数" Value="4" Minimum="2" Maximum="6" SpinButtonPlacementMode="Inline" ValueChanged="NumberBox_ValueChanged" automation:AutomationProperties.Name="每题选项数" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="GenerateButton" Click="GenerateButton_Click">
                    <TextBlock Text="生成预览" />
                </Button>
                <Button x:Name="SaveSvgButton" Click="SaveSvgButton_Click">
                    <TextBlock Text="保存 SVG" />
                </Button>
            </StackPanel>

            <TextBlock x:Name="TemplateStatusText" Text="填写参数后生成预览。" TextWrapping="Wrap" />

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Background="White">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Canvas x:Name="PreviewCanvas" Width="420" Height="594" Background="White" />
                </ScrollViewer>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
