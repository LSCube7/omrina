<Page
    x:Class="Omrina.Desktop.RecognitionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:local="using:Omrina.Desktop"
    NavigationCacheMode="Required">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="OMRINA 识别与复核" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Text="使用采集记录中关联的模板和原图运行本地识别。识别结果会保留置信指标，并明确标出空白、多选和待复核题目。" TextWrapping="Wrap" />
            </StackPanel>

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnSpacing="16" RowSpacing="8" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.ColumnSpan="2" Text="当前采集记录" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Grid.Row="1" Text="模板关联" />
                    <TextBlock x:Name="TemplateAssociationText" Grid.Row="1" Grid.Column="1" Text="尚未选择采集记录。" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Text="图像" />
                    <TextBlock x:Name="ImageMetadataText" Grid.Row="2" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" Text="原图路径" />
                    <TextBlock x:Name="ImagePathText" Grid.Row="3" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="4" Text="关联校验" />
                    <TextBlock x:Name="AssociationStatusText" Grid.Row="4" Grid.Column="1" Text="等待采集记录。" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Padding="12" CornerRadius="8" Background="White" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="原图（复核依据）" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="540">
                        <Image x:Name="OriginalImage" MaxWidth="720" MaxHeight="520" Stretch="Uniform" HorizontalAlignment="Left" />
                    </ScrollViewer>
                    <TextBlock Text="请结合原图、题号、选项状态和置信指标复核；颜色不是唯一判断依据。" TextWrapping="Wrap" Opacity="0.72" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="RunRecognitionButton" Click="RunRecognitionButton_Click" automation:AutomationProperties.Name="运行本地识别">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Play" />
                        <TextBlock Text="运行本地识别" />
                    </StackPanel>
                </Button>
                <Button x:Name="CancelRecognitionButton" IsEnabled="False" Click="CancelRecognitionButton_Click" automation:AutomationProperties.Name="取消识别">
                    <TextBlock Text="取消识别" />
                </Button>
            </StackPanel>
            <ProgressBar x:Name="RecognitionProgressBar" Minimum="0" Maximum="100" IsIndeterminate="False" Visibility="Collapsed" />
            <TextBlock x:Name="RecognitionProgressText" Text="等待识别。" TextWrapping="Wrap" />
            <InfoBar x:Name="RecognitionInfoBar" IsOpen="True" IsClosable="False" Severity="Informational" Title="识别状态" Message="请选择一条采集记录。" />

            <Border x:Name="RecognitionResultsBorder" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Text="识别结果" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="RecognitionSummaryText" Text="—" TextWrapping="Wrap" />
                    <TextBlock x:Name="RecognitionDiagnosticsText" Text="" TextWrapping="Wrap" />
                    <ListView x:Name="QuestionList" SelectionMode="None" IsItemClickEnabled="False" MaxHeight="520">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:RecognitionQuestionRow">
                                <Border Padding="8" Margin="0,0,0,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind QuestionLabel}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind StateText}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind SelectedText}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ConfidenceText}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ReviewText}" TextWrapping="Wrap" />
                                        <ComboBox Header="标准答案" ItemsSource="{x:Bind AnswerChoices}" IsEnabled="{x:Bind IsAnswerEditable}" SelectedItem="{x:Bind ExpectedAnswer, Mode=TwoWay}" SelectionChanged="ExpectedAnswer_SelectionChanged" HorizontalAlignment="Stretch" />
                                        <ComboBox Header="人工修订" ItemsSource="{x:Bind ReviewChoices}" SelectedItem="{x:Bind ReviewChoice, Mode=TwoWay}" SelectionChanged="ReviewChoice_SelectionChanged" HorizontalAlignment="Stretch" />
                                        <TextBox Header="修订原因（必填）" Text="{x:Bind ReviewReason, Mode=TwoWay}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border x:Name="WorkflowBorder" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Text="答案键、评分与人工复核" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="学校答卷使用考试统一设置的标准答案；空白、多选和低置信题目请先对照原图复核。" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ScoreButton" IsEnabled="False" Click="ScoreButton_Click" automation:AutomationProperties.Name="按标准答案评分">
                            <TextBlock Text="按标准答案评分" />
                        </Button>
                        <Button x:Name="ApplyReviewButton" IsEnabled="False" Click="ApplyReviewButton_Click" automation:AutomationProperties.Name="应用人工修订">
                            <TextBlock Text="应用人工修订" />
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="WorkflowStatusText" Text="请先完成识别。" TextWrapping="Wrap" />
                    <TextBlock x:Name="ReviewAuditText" Text="" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ExportJsonButton" IsEnabled="False" Click="ExportJsonButton_Click" automation:AutomationProperties.Name="导出JSON">
                    <TextBlock Text="导出 JSON" />
                </Button>
                <Button x:Name="ExportCsvButton" IsEnabled="False" Click="ExportCsvButton_Click" automation:AutomationProperties.Name="导出CSV">
                    <TextBlock Text="导出 CSV" />
                </Button>
            </StackPanel>
            <TextBlock x:Name="ExportStatusText" Text="导出会通过应用文件保存对话框完成。" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
