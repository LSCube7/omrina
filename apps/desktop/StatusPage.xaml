<Page
    x:Class="Omrina.Desktop.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="状态" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Text="查看本地服务状态，并进入模板或采集流程。" TextWrapping="Wrap" />
            </StackPanel>

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <SymbolIcon Symbol="Link" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="本地连接状态" FontWeight="SemiBold" />
                        <TextBlock x:Name="ConnectionStatusText" Text="正在启动本地连接服务。" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnSpacing="12" RowSpacing="12" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="模板" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="生成 A4 答题纸预览，保存 SVG，并在需要时发起系统打印。" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="采集" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="导入 PNG/JPEG 或使用已接入的扫描设备，并保留模板关联。" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <InfoBar
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="当前范围"
                    Message="本地单页识别、人工复核与评分已接入；批量处理和浏览器业务接口仍在后续范围。" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
