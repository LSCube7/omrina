<Window
    x:Class="Omrina.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OMRINA 本地服务">

    <Grid x:Name="RootLayout" RowDefinitions="Auto,*">
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Padding="16,0"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            ColumnDefinitions="Auto,*,Auto">
            <ContentControl
                x:Name="BrandMarkSlot"
                Width="0"
                Height="0"
                Visibility="Collapsed"
                ContentTemplate="{StaticResource OmrinaBrandMarkTemplate}"
                IsTabStop="False" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="OMRINA" FontWeight="SemiBold" />
                <TextBlock Text="本地服务" Opacity="0.72" />
            </StackPanel>
            <TextBlock
                x:Name="TitleBarPageText"
                Grid.Column="2"
                VerticalAlignment="Center"
                Opacity="0.72"
                Text="状态" />
        </Grid>

        <NavigationView
            x:Name="AppNavigationView"
            Grid.Row="1"
            IsBackEnabled="False"
            IsSettingsVisible="False"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="AppNavigationView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="状态" Tag="status" Icon="Home" />
                <NavigationViewItem Content="模板" Tag="template" Icon="Edit" />
                <NavigationViewItem Content="采集" Tag="capture" Icon="Camera" />
                <NavigationViewItem Content="设置" Tag="settings" Icon="Setting" />
                <NavigationViewItem Content="关于" Tag="about" Icon="Help" />
            </NavigationView.MenuItems>
            <Frame x:Name="NavigationFrame" />
        </NavigationView>
    </Grid>
</Window>
