<Page
    x:Class="Omrina.Desktop.SubjectiveReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    NavigationCacheMode="Required">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="OMRINA 主观题批阅" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Text="从本地采集记录中选择原图，按像素定义题目区域，再逐题保存草稿或确认评分。所有图片和批阅记录保存在此设备。" TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar
                x:Name="SubjectiveInfoBar"
                IsOpen="False"
                IsClosable="False"
                Severity="Informational"
                Title="主观题批阅"
                Message="请选择一条本地采集记录。" />
            <ProgressBar x:Name="SubjectiveProgressBar" IsIndeterminate="True" Visibility="Collapsed" />

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="采集记录与批阅记录" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ComboBox
                        x:Name="CapturePicker"
                        Header="本机采集记录"
                        PlaceholderText="选择一条已保存的采集记录"
                        SelectionChanged="CapturePicker_SelectionChanged"
                        automation:AutomationProperties.Name="本机采集记录" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ReloadCapturesButton" Click="ReloadCapturesButton_Click" automation:AutomationProperties.Name="加载本机采集记录">
                            <TextBlock Text="加载采集记录" />
                        </Button>
                        <Button x:Name="LoadMoreCapturesButton" Click="LoadMoreCapturesButton_Click" IsEnabled="False" automation:AutomationProperties.Name="继续加载采集记录">
                            <TextBlock Text="继续加载" />
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="CaptureListStatusText" Text="进入此页后加载本机采集记录。" TextWrapping="Wrap" />
                    <TextBlock x:Name="CaptureDiagnosticsText" IsTextSelectionEnabled="True" TextWrapping="Wrap" Visibility="Collapsed" />
                    <ComboBox
                        x:Name="ReviewPicker"
                        Header="已保存的批阅记录"
                        PlaceholderText="选择一条记录继续批阅"
                        SelectionChanged="ReviewPicker_SelectionChanged"
                        automation:AutomationProperties.Name="已保存的批阅记录" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ReloadReviewsButton" Click="ReloadReviewsButton_Click" IsEnabled="False" automation:AutomationProperties.Name="加载已保存批阅记录">
                            <TextBlock Text="加载批阅记录" />
                        </Button>
                        <Button x:Name="LoadMoreReviewsButton" Click="LoadMoreReviewsButton_Click" IsEnabled="False" automation:AutomationProperties.Name="继续加载批阅记录">
                            <TextBlock Text="继续加载" />
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="ReviewListStatusText" Text="可加载本机保存的批阅记录并继续批阅。" TextWrapping="Wrap" />
                    <TextBlock x:Name="ReviewDiagnosticsText" IsTextSelectionEnabled="True" TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="SelectedReviewSummaryText" Text="尚未打开批阅记录。" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="原图与题目区域" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="OriginalCaptureSummaryText" Text="选择采集记录后显示图像信息。" TextWrapping="Wrap" />
                    <Border Padding="8" CornerRadius="8" Background="White" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="440">
                            <Image x:Name="OriginalCaptureImage" MaxWidth="720" MaxHeight="420" Stretch="Uniform" HorizontalAlignment="Left" />
                        </ScrollViewer>
                    </Border>
                    <TextBlock Text="用整数像素填写区域坐标与尺寸。区域必须完整位于原图内；当前版本不会自动定位题目。" TextWrapping="Wrap" Opacity="0.78" />

                    <Grid ColumnSpacing="12" RowSpacing="8" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                        <TextBox
                            x:Name="RegionQuestionNumberBox"
                            Header="题号"
                            Text="1"
                            MaxLength="10"
                            automation:AutomationProperties.Name="区域题号" />
                        <TextBox
                            x:Name="RegionMaximumScoreBox"
                            Grid.Column="1"
                            Header="满分"
                            Text="10"
                            MaxLength="32"
                            automation:AutomationProperties.Name="题目满分" />
                        <TextBox
                            x:Name="RegionXBox"
                            Grid.Row="1"
                            Header="左上角 X"
                            Text="0"
                            MaxLength="10"
                            automation:AutomationProperties.Name="区域左上角 X 坐标" />
                        <TextBox
                            x:Name="RegionYBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Header="左上角 Y"
                            Text="0"
                            MaxLength="10"
                            automation:AutomationProperties.Name="区域左上角 Y 坐标" />
                        <TextBox
                            x:Name="RegionWidthBox"
                            Grid.Row="2"
                            Header="宽度"
                            Text="1"
                            MaxLength="10"
                            automation:AutomationProperties.Name="区域宽度" />
                        <TextBox
                            x:Name="RegionHeightBox"
                            Grid.Row="2"
                            Grid.Column="1"
                            Header="高度"
                            Text="1"
                            MaxLength="10"
                            automation:AutomationProperties.Name="区域高度" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AddRegionButton" Click="AddRegionButton_Click" IsEnabled="False" automation:AutomationProperties.Name="添加题目区域">
                            <TextBlock Text="添加题目区域" />
                        </Button>
                        <Button x:Name="RemoveRegionButton" Click="RemoveRegionButton_Click" IsEnabled="False" automation:AutomationProperties.Name="移除所选题目区域">
                            <TextBlock Text="移除所选区域" />
                        </Button>
                    </StackPanel>
                    <ListView
                        x:Name="RegionList"
                        SelectionMode="Single"
                        SelectionChanged="RegionList_SelectionChanged"
                        MaxHeight="220"
                        automation:AutomationProperties.Name="待创建的题目区域列表">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="RegionListStatusText" Text="添加 1 到 64 个题目区域后创建批阅记录。" TextWrapping="Wrap" />
                    <Button x:Name="CreateReviewButton" Click="CreateReviewButton_Click" IsEnabled="False" HorizontalAlignment="Left" automation:AutomationProperties.Name="创建主观题批阅记录">
                        <TextBlock Text="创建批阅记录" />
                    </Button>
                </StackPanel>
            </Border>

            <Border x:Name="ReviewEditorBorder" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Text="逐题批阅" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="ReviewVersionText" Text="版本 —" TextWrapping="Wrap" />
                    <TextBlock x:Name="FinalSubtotalText" Text="尚未全部确认，暂不显示主观题小计。" TextWrapping="Wrap" />
                    <ListView
                        x:Name="SubjectiveQuestionList"
                        SelectionMode="Single"
                        MaxHeight="280"
                        SelectionChanged="SubjectiveQuestionList_SelectionChanged"
                        automation:AutomationProperties.Name="主观题列表">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="SelectedQuestionText" Text="请选择一道题目。" TextWrapping="Wrap" />
                    <Border Padding="8" CornerRadius="8" Background="White" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="360">
                            <Image x:Name="QuestionRegionImage" MaxWidth="720" MaxHeight="340" Stretch="Uniform" HorizontalAlignment="Left" />
                        </ScrollViewer>
                    </Border>
                    <TextBlock x:Name="QuestionImageStatusText" Text="选择一道题目后显示该区域图像。" TextWrapping="Wrap" />
                    <TextBox
                        x:Name="QuestionScoreBox"
                        Header="本题得分"
                        Text="0"
                        MaxLength="32"
                        TextChanged="QuestionScoreBox_TextChanged"
                        automation:AutomationProperties.Name="本题得分" />
                    <TextBox
                        x:Name="QuestionCommentBox"
                        Header="评语（最多 256 个字符）"
                        MaxLength="256"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        TextChanged="QuestionCommentBox_TextChanged"
                        automation:AutomationProperties.Name="本题评语" />
                    <TextBox
                        x:Name="ReviewerBox"
                        Header="批阅者（最多 64 个字符）"
                        MaxLength="64"
                        TextChanged="ReviewerBox_TextChanged"
                        automation:AutomationProperties.Name="批阅者" />
                    <StackPanel Orientation="Vertical" Spacing="8">
                        <Button x:Name="SaveDraftButton" Click="SaveDraftButton_Click" IsEnabled="False" automation:AutomationProperties.Name="保存为草稿">
                            <TextBlock Text="保存草稿" />
                        </Button>
                        <Button x:Name="ConfirmScoreButton" Click="ConfirmScoreButton_Click" IsEnabled="False" automation:AutomationProperties.Name="确认当前分数">
                            <TextBlock Text="确认当前分数" />
                        </Button>
                        <Button x:Name="ResetQuestionButton" Click="ResetQuestionButton_Click" IsEnabled="False" automation:AutomationProperties.Name="重置为未批阅">
                            <TextBlock Text="重置为未批阅" />
                        </Button>
                        <Button x:Name="ReloadReviewButton" Click="ReloadReviewButton_Click" IsEnabled="False" automation:AutomationProperties.Name="重新读取批阅记录">
                            <TextBlock Text="重新读取" />
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="GradeActionStatusText" Text="选择题目后填写得分和评语。" TextWrapping="Wrap" />

                    <TextBlock Text="批阅历史" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock
                            x:Name="ReviewHistoryText"
                            Text="尚无批阅历史。"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                    </ScrollViewer>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ExportReviewJsonButton" Click="ExportReviewJsonButton_Click" IsEnabled="False" automation:AutomationProperties.Name="导出主观题JSON">
                            <TextBlock Text="导出 JSON" />
                        </Button>
                        <Button x:Name="ExportReviewCsvButton" Click="ExportReviewCsvButton_Click" IsEnabled="False" automation:AutomationProperties.Name="导出主观题CSV">
                            <TextBlock Text="导出 CSV" />
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="ReviewExportStatusText" Text="导出会通过应用文件保存对话框完成。" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
